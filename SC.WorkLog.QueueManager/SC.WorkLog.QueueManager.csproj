<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SC.WorkLog.Application\SC.WorkLog.Application.csproj" />
    <ProjectReference Include="..\SC.WorkLog.Domain\SC.WorkLog.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;Staging</Configurations>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\SC.WorkLog.Infrastructure\Data\*.csv" Link="Data\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyInfrastructureDataFiles" AfterTargets="Build">
    <ItemGroup>
      <InfrastructureDataFiles Include="..\SC.WorkLog.Infrastructure\Data\*.csv" />
    </ItemGroup>
    <Copy SourceFiles="@(InfrastructureDataFiles)" DestinationFolder="$(OutDir)Data" SkipUnchangedFiles="true" />
  </Target>

</Project>
